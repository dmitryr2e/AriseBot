# Скопируй в .env и заполни. См. DEPLOY.md для процедуры первого запуска.

# Токен бота из @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=SystemAriseBot
ADMIN_IDS=
GEMINI_API_KEY=
BOT_TZ=Europe/Moscow

# Пути
# BOT_DATA_DIR=./data
# BOT_DB_PATH=./data/hunter.db
# BOT_BACKUP_DIR=./data/backups

# Бэкапы БД: обязательно сгенерируй отдельный ключ и храни его вне volume.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
